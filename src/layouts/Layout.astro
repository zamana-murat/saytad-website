---
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import { SITE, type Lang } from '@data/site';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Pathname only, leading slash, no domain (e.g. "/urunler/fistikli-baklava"). */
  path: string;
  /** Alternate-language path (the same page in the other locale). */
  altPath: string;
  /** Path of OG image relative to site root. */
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: 'website' | 'article';
  /** Optional inline JSON-LD blocks (each rendered as its own <script>). */
  schema?: object[];
  /** ISO 8601 date for `dateModified` / `article:modified_time`. */
  dateModified?: string;
}

const {
  lang,
  title,
  description,
  path,
  altPath,
  ogImage = '/images/FistikliBaklavaMainpage.webp',
  ogImageAlt = 'Saytad Fıstıklı Baklava',
  ogType = 'website',
  schema = [],
  dateModified,
} = Astro.props;

const url = `${SITE.url}${path}`;
const trUrl = lang === 'tr' ? url : `${SITE.url}${altPath}`;
const enUrl = lang === 'en' ? url : `${SITE.url}${altPath}`;
const ogImageUrl = ogImage.startsWith('http') ? ogImage : `${SITE.url}${ogImage}`;
const ogLocale = lang === 'tr' ? 'tr_TR' : 'en_US';
const ogLocaleAlt = lang === 'tr' ? 'en_US' : 'tr_TR';
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.brand} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

    <link rel="canonical" href={url} />
    <link rel="alternate" hreflang="tr" href={trUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={`${SITE.url}${path === '/' || path === '/en' ? '/' : path}`} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.brand} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlt} />
    {dateModified && <meta property="article:modified_time" content={dateModified} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@saytadbaklava" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <link rel="preload" href="/assets/css/main.css" as="style" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400;1,600&family=Outfit:wght@300;400;500&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/assets/css/main.css" />
    <slot name="extra-css" />

    {schema.map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}

    <slot name="head" />
  </head>
  <body>
    <Header lang={lang} pathname={path} />
    <slot />
    <Footer lang={lang} />

    <script is:inline>
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('visible');
              io.unobserve(e.target);
            }
          });
        },
        { threshold: 0.08 }
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
