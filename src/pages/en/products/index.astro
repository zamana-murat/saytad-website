---
import Layout from '@layouts/Layout.astro';
import ProductsListing from '@components/ProductsListing.astro';
import { orgSchema, websiteSchema, webPageSchema, breadcrumbSchema } from '@data/schema';
import { SITE } from '@data/site';

const url = `${SITE.url}/en/products`;
const title = 'Our Products — Baklava, Kadayıf & Vegan | Saytad';
const description = "26 varieties of handcrafted Turkish sweets: pistachio baklava, kadayıf, cold baklava and vegan options. Made fresh daily in Istanbul, same-day delivery.";

const schema = [
  orgSchema,
  websiteSchema,
  webPageSchema({ url, name: title, description, inLanguage: 'en' }),
  breadcrumbSchema([
    { name: 'Home', url: `${SITE.url}/en` },
    { name: 'Our Products', url },
  ]),
];
---
<Layout
  lang="en"
  title={title}
  description={description}
  path="/en/products"
  altPath="/urunler"
  schema={schema}
>
  <link slot="extra-css" rel="stylesheet" href="/assets/css/products-list.css" />
  <ProductsListing lang="en" />
</Layout>
