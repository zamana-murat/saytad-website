---
import Layout from '@layouts/Layout.astro';
import BlogPostBody from '@components/BlogPostBody.astro';
import { BLOG_POSTS } from '@data/blog';
import { orgSchema, websiteSchema, articleSchema, breadcrumbSchema } from '@data/schema';
import { SITE } from '@data/site';

export function getStaticPaths() {
  return BLOG_POSTS.map((p) => ({
    params: { slug: p.slugTR },
    props: { post: p },
  }));
}

const { post } = Astro.props;
const url = `${SITE.url}/blog/${post.slugTR}`;
const altUrl = `/en/blog/${post.slugEN}`;
const fullTitle = `${post.title.tr} ${post.titleEm.tr}`.trim();
// SEO title — short form (just the lead clause + brand) to stay under ~60 chars
const seoTitle = post.title.tr.replace(/[:：]\s*$/, '').trim();
const title = `${seoTitle} | Saytad Dergisi`;
// Trim description to ~155 chars on word boundary
const rawDesc = post.excerpt.tr || post.lead.tr;
const description = rawDesc.length <= 160
  ? rawDesc
  : rawDesc.slice(0, 155).replace(/\s+\S*$/, '') + '…';

const schema = [
  orgSchema,
  websiteSchema,
  articleSchema({
    url,
    headline: fullTitle,
    description,
    image: `${SITE.url}${post.heroImage}`,
    datePublished: post.isoDate,
    author: post.author.tr,
    inLanguage: 'tr',
  }),
  breadcrumbSchema([
    { name: 'Ana Sayfa', url: `${SITE.url}/` },
    { name: 'Dergi', url: `${SITE.url}/blog` },
    { name: fullTitle, url },
  ]),
];
---
<Layout
  lang="tr"
  title={title}
  description={description}
  path={`/blog/${post.slugTR}`}
  altPath={altUrl}
  ogImage={post.heroImage}
  ogImageAlt={fullTitle}
  ogType="article"
  schema={schema}
  dateModified={post.isoDate}
>
  <link slot="extra-css" rel="stylesheet" href="/assets/css/blog.css" />
  <BlogPostBody post={post} lang="tr" />
</Layout>
