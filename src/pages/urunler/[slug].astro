---
import Layout from '@layouts/Layout.astro';
import ProductDetail from '@components/ProductDetail.astro';
import { PRODUCTS } from '@data/products';
import { orgSchema, websiteSchema, productSchema, breadcrumbSchema } from '@data/schema';
import { SITE } from '@data/site';

export function getStaticPaths() {
  return PRODUCTS.map((p) => ({
    params: { slug: p.slugTR },
    props: { product: p },
  }));
}

const { product } = Astro.props;
const url = `${SITE.url}/urunler/${product.slugTR}`;
const altUrl = `/en/products/${product.slugEN}`;

const titleSuffixTR: Record<string, string> = {
  baklava: 'Gaziantep Usulü',
  kadayif: 'El Yapımı',
  cold: 'Soğuk Baklava',
  vegan: 'Vegan Tatlı',
};
// Only add suffix if total stays under 60 chars; otherwise keep title clean
const candidateTitle = `${product.nameTR} — ${titleSuffixTR[product.category]} | Saytad`;
const title = candidateTitle.length <= 60 ? candidateTitle : `${product.nameTR} | Saytad Baklava`;
// Pad description to ~155 chars when needed (cap at 158)
const baseDesc = product.descTR;
const padded = baseDesc.length >= 80
  ? baseDesc
  : `${baseDesc}. ${product.priceTR} — İstanbul'da el yapımı, aynı gün teslimat.`;
const description = padded.length > 158 ? padded.slice(0, 155).replace(/\s+\S*$/, '') + '…' : padded;

const schema = [
  orgSchema,
  websiteSchema,
  productSchema({
    name: product.nameTR,
    description,
    image: `${SITE.url}${product.image || '/images/FistikliBaklavaMainpage.webp'}`,
    category: 'Türk Tatlıları / Baklava',
    inLanguage: 'tr',
  }),
  breadcrumbSchema([
    { name: 'Ana Sayfa', url: `${SITE.url}/` },
    { name: 'Ürünler', url: `${SITE.url}/urunler` },
    { name: product.nameTR, url },
  ]),
];
---
<Layout
  lang="tr"
  title={title}
  description={description}
  path={`/urunler/${product.slugTR}`}
  altPath={altUrl}
  ogImage={product.image || undefined}
  ogImageAlt={`Saytad ${product.nameTR}`}
  ogType="article"
  schema={schema}
>
  <link slot="extra-css" rel="stylesheet" href="/assets/css/products.css" />
  <ProductDetail product={product} lang="tr" />
</Layout>
