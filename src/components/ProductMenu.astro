---
import { PRODUCTS, type ProductCategory } from '@data/products';
import { ROUTES, type Lang } from '@data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const r = ROUTES[lang];

const tabs: { id: ProductCategory; label: string }[] = lang === 'tr'
  ? [
      { id: 'baklava', label: 'Baklava' },
      { id: 'kadayif', label: 'Kadayıf' },
      { id: 'cold', label: 'Soğuk Baklava' },
      { id: 'vegan', label: 'Vegan' },
    ]
  : [
      { id: 'baklava', label: 'Baklava' },
      { id: 'kadayif', label: 'Kadayıf' },
      { id: 'cold', label: 'Cold Baklava' },
      { id: 'vegan', label: 'Vegan' },
    ];

const labels = lang === 'tr'
  ? { eyebrow: 'Menümüz', title: 'Her Parça,', titleEm: 'Bir Şaheser' }
  : { eyebrow: 'Our Menu', title: 'Every Piece,', titleEm: 'A Masterpiece' };
---
<section class="menu-section" id="menu">
  <div class="menu-header reveal">
    <p class="section-label">{labels.eyebrow}</p>
    <h2 class="section-title">{labels.title} <em>{labels.titleEm}</em></h2>
  </div>

  <div class="menu-tabs">
    {tabs.map((t, i) => (
      <button class={`tab-btn${i === 0 ? ' active' : ''}`} data-tab={t.id}>{t.label}</button>
    ))}
  </div>

  {tabs.map((t, i) => {
    const items = PRODUCTS.filter((p) => p.category === t.id);
    return (
      <div id={t.id} class={`tab-panel${i === 0 ? ' active' : ''}`}>
        <div class="menu-grid">
          {items.map((p) => {
            const slug = lang === 'tr' ? p.slugTR : p.slugEN;
            const name = lang === 'tr' ? p.nameTR : p.nameEN;
            const desc = lang === 'tr' ? p.descTR : p.descEN;
            const price = lang === 'tr' ? p.priceTR : p.priceEN;
            const objectPos = p.imagePos ?? 'center';
            return (
              <a href={r.product(slug)} class={`menu-item${p.image ? ' menu-item--photo' : ''}`}>
                {p.image && (
                  <picture>
                    <source srcset={p.image.replace(/\.webp$/, '.avif')} type="image/avif" />
                    <img src={p.image} alt={name} loading="lazy" decoding="async" width="800" height="600" style={`object-position:${objectPos}`} class="menu-item-img" />
                  </picture>
                )}
                <div>
                  <p class="menu-item-name">{name}</p>
                  <p class="menu-item-desc">{desc}</p>
                </div>
                <p class="menu-item-price">{price}</p>
              </a>
            );
          })}
        </div>
      </div>
    );
  })}
</section>

<script is:inline>
  document.querySelectorAll('.menu-tabs .tab-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = btn.getAttribute('data-tab');
      document.querySelectorAll('.menu-section .tab-panel').forEach((p) => p.classList.remove('active'));
      document.querySelectorAll('.menu-tabs .tab-btn').forEach((b) => b.classList.remove('active'));
      const panel = document.getElementById(id);
      if (panel) panel.classList.add('active');
      btn.classList.add('active');
    });
  });
</script>
