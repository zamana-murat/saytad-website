---
import { ROUTES, type Lang } from '@data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const r = ROUTES[lang];

const t = lang === 'tr'
  ? {
      eyebrow: 'Sevdikleriniz İçin',
      title: 'Her Anı Daha',
      titleEm: 'Tatlı Yapın',
      body: 'Hediye kutularımız özenle paketlenir ve dünyaya gönderilir — taze, güvenli ve unutulmaz. Her kutlama için mükemmel bir jest.',
      cta: 'Hediye Kutusu Sipariş Et',
    }
  : {
      eyebrow: 'For Your Loved Ones',
      title: 'Make Every Occasion',
      titleEm: 'Sweeter',
      body: 'Our gift boxes are lovingly packed and shipped worldwide — fresh, secure, and unforgettable. The perfect gesture for any celebration.',
      cta: 'Order a Gift Box',
    };
---
<div class="gift-banner">
  <picture>
    <source
      type="image/avif"
      sizes="100vw"
      srcset="/images/Beyaz-Cikolatali-Soguk-Baklava-768w.avif 768w, /images/Beyaz-Cikolatali-Soguk-Baklava-1200w.avif 1200w, /images/Beyaz-Cikolatali-Soguk-Baklava.avif 1600w"
    />
    <source
      type="image/webp"
      sizes="100vw"
      srcset="/images/Beyaz-Cikolatali-Soguk-Baklava-768w.webp 768w, /images/Beyaz-Cikolatali-Soguk-Baklava-1200w.webp 1200w, /images/Beyaz-Cikolatali-Soguk-Baklava.webp 1600w"
    />
    <img class="gift-banner-bg" src="/images/Beyaz-Cikolatali-Soguk-Baklava.webp" alt="" loading="lazy" decoding="async" width="1600" height="2133" />
  </picture>
  <div class="gift-banner-content reveal">
    <p class="section-label">{t.eyebrow}</p>
    <h2 class="section-title section-title--light">{t.title} <em>{t.titleEm}</em></h2>
    <p class="gift-banner-text">{t.body}</p>
    <a href={r.contact} class="btn-gold">{t.cta}</a>
  </div>
</div>
